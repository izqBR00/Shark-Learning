        <messages/>
        <name>Block Duplicate Trainings</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }

   var ga = new GlideAjax("BlockDuplicateTrainings");
   ga.addParam("sysparam_name", "blockDuplicateTrainings");
   ga.addParam("sysparam_course", g_form.getValue("course"));
   ga.addParam("sysparam_date", g_form.getValue("date"));

   ga.getXMLAnswer(function(response) {
	 if(response == "true"){
		g_form.addErrorMessage("Can't create duplicate trainings");
		g_form.setValue("date", "");
	 } else {
		g_form.clearMessages();
	 }
   });
   
}]]></script>
